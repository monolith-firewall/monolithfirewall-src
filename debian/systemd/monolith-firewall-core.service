[Unit]
Description=Monolith FireWall Core Service
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/monolith-firewall/core
ExecStart=/opt/monolith-firewall/core/Monolith.FireWall.Core
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=monolith-firewall
RuntimeDirectoryMode=0755
ReadWritePaths=/var/lib/monolith-firewall /etc/monolith-firewall /etc/network /run/monolith-firewall /run/network /opt/monolith-firewall/packages

[Install]
WantedBy=multi-user.target
