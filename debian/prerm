#!/bin/bash
set -e

case "$1" in
    remove|upgrade|deconfigure)
        systemd_ok=0
        if command -v systemctl >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
            if timeout 5 systemctl is-system-running >/dev/null 2>&1; then
                systemd_ok=1
            fi
        fi

        if [ "$systemd_ok" = "1" ]; then
            # Stop services
            systemctl stop monolith-firewall-webui.service || true
            systemctl stop monolith-firewall-core.service || true
        fi

        # Disable services on removal (but not upgrade)
        if [ "$1" = "remove" ] && [ "$systemd_ok" = "1" ]; then
            systemctl disable monolith-firewall-webui.service || true
            systemctl disable monolith-firewall-core.service || true
        fi
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
