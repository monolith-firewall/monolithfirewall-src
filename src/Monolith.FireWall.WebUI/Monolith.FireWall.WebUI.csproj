<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Monolith.FireWall.Common/Monolith.FireWall.Common.csproj" />
    <ProjectReference Include="../Monolith.FireWall.Platform/Monolith.FireWall.Platform.csproj" />
    <PackageReference Include="CodeLogic" Version="4.0.0" />
    <PackageReference Include="CodeLogic.SQLite" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Pages/**/*.cshtml">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
