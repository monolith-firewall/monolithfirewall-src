@page "/firewall/rules"
@{
    Layout = null;
}

<div class="package-page firewall-rules-page" data-module="rules" data-package="firewall">
    <div class="container-fluid p-4">

        <div id="rulesStatusMessage" class="alert d-none"></div>

        <div id="pendingChangesBanner" class="alert alert-warning d-none mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Pending Changes</strong>
                    <span class="ms-2">Firewall configuration has been modified. Apply or discard to continue.</span>
                </div>
                <div>
                    <button type="button" class="btn btn-sm btn-outline-light me-2" id="btnPreviewChanges">
                        <i class="bi bi-eye me-1"></i>Preview
                    </button>
                    <button type="button" class="btn btn-sm btn-success me-2" id="btnApplyChanges">
                        <i class="bi bi-check-lg me-1"></i>Apply Changes
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnDiscardChanges">
                        <i class="bi bi-x-lg me-1"></i>Discard
                    </button>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-0"><i class="bi bi-sliders me-2"></i>Default Policies</h5>
                        <small class="text-muted">Configure default firewall behavior for each interface role</small>
                    </div>
                    <button type="button" class="btn btn-primary" id="btnSaveDefaults">
                        <i class="bi bi-save me-1"></i>Save Defaults
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <!-- Default Actions Section -->
                    <div class="col-12">
                        <h6 class="text-muted border-bottom pb-2 mb-3">
                            <i class="bi bi-arrow-right-circle me-1"></i>Default Actions
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <span class="badge bg-success me-2">LAN</span>Default Action
                                </label>
                                <select class="form-select" id="defaultLanAction">
                                    <option value="pass">Pass (Allow traffic)</option>
                                    <option value="block">Block (Silently drop)</option>
                                    <option value="reject">Reject (ICMP unreachable)</option>
                                </select>
                                <div class="form-text">Traffic from LAN networks</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <span class="badge bg-danger me-2">WAN</span>Default Action
                                </label>
                                <select class="form-select" id="defaultWanAction">
                                    <option value="pass">Pass (Allow traffic)</option>
                                    <option value="block">Block (Silently drop)</option>
                                    <option value="reject">Reject (ICMP unreachable)</option>
                                </select>
                                <div class="form-text">Traffic from WAN interfaces</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <span class="badge bg-secondary me-2">OPT</span>Default Action
                                </label>
                                <select class="form-select" id="defaultOptAction">
                                    <option value="pass">Pass (Allow traffic)</option>
                                    <option value="block">Block (Silently drop)</option>
                                    <option value="reject">Reject (ICMP unreachable)</option>
                                </select>
                                <div class="form-text">Traffic from optional interfaces</div>
                            </div>
                        </div>
                    </div>

                    <!-- System Options Section -->
                    <div class="col-12 mt-4">
                        <h6 class="text-muted border-bottom pb-2 mb-3">
                            <i class="bi bi-gear me-1"></i>System Rules
                        </h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="defaultBlockReserved" role="switch">
                                    <label class="form-check-label" for="defaultBlockReserved">
                                        <strong>Block RFC1918 on WAN</strong>
                                    </label>
                                </div>
                                <div class="form-text ms-4">Block private IP ranges (10.x, 172.16-31.x, 192.168.x) from WAN</div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="defaultAllowWebUi" role="switch">
                                    <label class="form-check-label" for="defaultAllowWebUi">
                                        <strong>Allow WebUI Access</strong>
                                    </label>
                                </div>
                                <div class="form-text ms-4">Allow HTTP/HTTPS on management interfaces</div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="defaultAllowSsh" role="switch">
                                    <label class="form-check-label" for="defaultAllowSsh">
                                        <strong>Allow SSH Access</strong>
                                    </label>
                                </div>
                                <div class="form-text ms-4">Allow SSH (port 22) on all interfaces for system management</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><i class="bi bi-list-check me-2"></i>Interface Rules</h5>
            </div>
            <div class="card-body p-0">
                <ul class="nav nav-tabs nav-fill border-bottom" id="rulesTabs" role="tablist"></ul>
                <div class="tab-content p-3" id="rulesTabContent"></div>
            </div>
        </div>
    </div>
</div>
