@page "/"
@{
    var isAjax = Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { return; }
    Layout = null;
    ViewData["Title"] = "Monolith Firewall";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    <link href="/css/bootstrap.min.css?v=20260103" rel="stylesheet" />
    <link href="/vendor/fontawesome/css/all.min.css?v=7.1.0" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <link href="/css/monolith-theme.css?v=20260111" rel="stylesheet" />
    <link href="/css/app.css?v=20260103" rel="stylesheet" />
    <link href="/css/package-header.css?v=20260116" rel="stylesheet" />
    <script src="/js/core/theme-manager.js?v=20260116"></script>
    <script>
        // Initialize theme immediately to prevent flash
        (function() {
            const savedTheme = localStorage.getItem('monolith-theme') || 'dark';
            const html = document.documentElement;
            if (savedTheme === 'auto') {
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                html.setAttribute('data-bs-theme', prefersDark ? 'dark' : 'light');
            } else {
                html.setAttribute('data-bs-theme', savedTheme);
            }
        })();
    </script>
</head>
<body>
    <nav class="navbar navbar-expand-lg top-navbar sticky-top" id="top-navbar">
        <div class="container-fluid navbar-container">
            <a class="navbar-brand" href="/" data-route="/">
                <div class="setup-logo">
                    <i class="bi bi-shield-check"></i>
                    <span class="setup-brand">Monolith FireWall</span>
                </div>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="nav-icon fa-solid fa-gear"></i>
                            System
                        </a>
                        <ul class="dropdown-menu" id="menu-system">
                            <li><span class="dropdown-item-text text-muted small">Loading...</span></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="nav-icon fa-solid fa-network-wired"></i>
                            Interfaces
                        </a>
                        <ul class="dropdown-menu" id="interfaces-menu">
                            <li><span class="dropdown-item-text text-muted small">Loading...</span></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="nav-icon fa-solid fa-shield-halved"></i>
                            Firewall
                        </a>
                        <ul class="dropdown-menu" id="menu-firewall">
                            <li><span class="dropdown-item-text text-muted small">Loading...</span></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="nav-icon fa-solid fa-box-open"></i>
                            Packages
                        </a>
                        <ul class="dropdown-menu" id="packages-menu">
                            <li><span class="dropdown-item-text text-muted small">Loading packages...</span></li>
                        </ul>
                    </li>
                    <!-- Status Menu -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="nav-icon fa-solid fa-chart-line"></i>
                            Status
                        </a>
                        <ul class="dropdown-menu" id="menu-status">
                            <li><span class="dropdown-item-text text-muted small">Loading...</span></li>
                        </ul>
                    </li>
                </ul>
                <!-- Right side menu items: Help, Monitoring, Notifications -->
                <ul class="navbar-nav" style="margin-left: auto;">
                    <!-- Help Menu (icon only) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-icon-button" href="#" role="button" data-bs-toggle="dropdown" title="Help">
                            <i class="fa-solid fa-circle-question fa-lg"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/about" data-route="/about"><i class="dropdown-icon fa-solid fa-circle-info"></i> About Monolith Firewall</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="https://monolithfirewall.com/" target="_blank" rel="noopener noreferrer"><i class="dropdown-icon fa-solid fa-globe"></i> Website</a></li>
                            <li><a class="dropdown-item" href="https://github.com/monolith-firewall/" target="_blank" rel="noopener noreferrer"><i class="dropdown-icon fa-brands fa-github"></i> GitHub</a></li>
                        </ul>
                    </li>
                    <!-- Monitoring Status Indicator -->
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link nav-icon-button" data-bs-toggle="dropdown" aria-label="System status" style="display: flex; align-items: center;">
                            <span class="status-indicator status-unknown" id="monitoring-status-indicator"></span>
                            <i class="fa-solid fa-circle-check fa-lg"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" id="monitoring-status-menu">
                            <li><span class="dropdown-item-text text-muted small">Loading system status...</span></li>
                        </ul>
                    </li>
                    <!-- Notifications -->
                    <li class="nav-item dropdown">
                        <a href="#" class="nav-link nav-icon-button position-relative" data-bs-toggle="dropdown" aria-label="System notifications" style="display: flex; align-items: center;">
                            <i class="fa-solid fa-bell fa-lg"></i>
                            <span class="badge bg-danger nav-badge d-none" id="notifications-badge">0</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end" id="notifications-menu">
                            <li><span class="dropdown-item-text text-muted small">Loading notifications...</span></li>
                        </ul>
                    </li>
                </ul>
                <!-- User Menu (all the way to the right) -->
                <div class="user-menu d-flex align-items-center gap-2">
                    <div class="dropdown">
                        <a href="#" class="user-dropdown" data-bs-toggle="dropdown">
                            <i class="user-icon fa-solid fa-user"></i>
                            <span class="user-info" id="user-info">User</span>
                            <i class="dropdown-arrow fa-solid fa-chevron-down"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/profile" data-route="/profile">My Profile</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <div class="dropdown-item-text">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>Theme</span>
                                        <div class="btn-group btn-group-sm" role="group" id="navbar-theme-toggle">
                                            <input type="radio" class="btn-check" name="navbar-theme" id="navbar-theme-light" value="light" autocomplete="off">
                                            <label class="btn btn-outline-secondary" for="navbar-theme-light" title="Light">
                                                <i class="fas fa-sun"></i>
                                            </label>
                                            <input type="radio" class="btn-check" name="navbar-theme" id="navbar-theme-dark" value="dark" autocomplete="off">
                                            <label class="btn btn-outline-secondary" for="navbar-theme-dark" title="Dark">
                                                <i class="fas fa-moon"></i>
                                            </label>
                                            <input type="radio" class="btn-check" name="navbar-theme" id="navbar-theme-auto" value="auto" autocomplete="off">
                                            <label class="btn btn-outline-secondary" for="navbar-theme-auto" title="Auto">
                                                <i class="fas fa-adjust"></i>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" id="btn-logout">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="main-content">
        <div class="container-fluid content-container" id="page-content"></div>
    </div>

    <script src="/js/jquery.min.js?v=20260101"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="/js/bootstrap.bundle.min.js?v=20260103"></script>
    <script src="/js/core/monolith.api.js?v=20260104"></script>
    <script src="/js/core/monolith.ui.js?v=20260104"></script>
    <script src="/js/core/monolith.auth.js?v=20260104"></script>
    <script src="/js/core/module-loader.js?v=20260101170000"></script>
    <script src="/js/core/cms-client.js?v=20260115090000"></script>
    <script src="/js/core/cms-router.js?v=20260115090000"></script>
    <script src="/js/core/menu.js?v=20260123"></script>
    <script src="/js/nat.js?v=20260115"></script>
    <script src="/js/app.js?v=20260123"></script>
</body>
</html>
