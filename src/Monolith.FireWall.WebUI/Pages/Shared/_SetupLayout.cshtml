@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Setup Wizard") - Monolith FireWall</title>
    
    <!-- Bootstrap CSS -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Setup Wizard CSS -->
    <link href="~/css/setup-wizard.css" rel="stylesheet" asp-append-version="true">
    <!-- jQuery (needed before inline setup scripts) -->
    <script src="~/js/jquery.min.js" asp-append-version="true"></script>
    <script>
        if (window.jQuery && !window.$) {
            window.$ = window.jQuery;
        }
    </script>
    
    @RenderSection("Head", required: false)
</head>
<body class="setup-wizard-body">
    <!-- Setup Header -->
    <header class="setup-header">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="setup-logo">
                        <i class="bi bi-shield-check"></i>
                        <span class="setup-brand">Monolith FireWall</span>
                    </div>
                </div>
                <div class="col">
                    <div class="setup-progress-container">
                        <div class="setup-progress-bar">
                            <div class="setup-progress-fill" id="setup-progress-fill" style="width: 0%"></div>
                        </div>
                        <div class="setup-progress-text">
                            <span id="setup-progress-text">Step 1 of 5</span>
                        </div>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="button" class="btn btn-link btn-sm text-muted" id="btn-skip-setup-header" style="text-decoration: none;">
                        <i class="bi bi-x-circle me-1"></i> Skip Setup
                    </button>
                </div>
            </div>
        </div>
    </header>

    <!-- Setup Content -->
    <main class="setup-content">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-8">
                    @RenderBody()
                </div>
            </div>
        </div>
    </main>

    <!-- Setup Navigation Footer -->
    <footer class="setup-footer">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <!-- Navigation Buttons -->
                    <div class="setup-nav" id="setup-nav-container">
                        <div class="setup-nav-left">
                            <button type="button" class="btn btn-outline-secondary" id="btn-setup-back">
                                <i class="bi bi-arrow-left me-1"></i> Back
                            </button>
                        </div>
                        <div class="setup-nav-right">
                            <button type="button" class="btn btn-outline-warning me-2" id="btn-setup-skip" style="display: none;">
                                Skip
                            </button>
                            <button type="button" class="btn btn-primary" id="btn-setup-next">
                                Next <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                            <button type="button" class="btn btn-success" id="btn-setup-finish" style="display: none;">
                                <i class="bi bi-check-circle me-1"></i> Finish
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col text-center">
                    <p class="text-muted small mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        You can skip setup and configure these settings later in the dashboard.
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="~/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <!-- Monolith API Client -->
    <script src="~/js/core/monolith.api.js" asp-append-version="true"></script>
    <!-- Monolith UI Components -->
    <script src="~/js/core/monolith.ui.js" asp-append-version="true"></script>
    <!-- Setup Wizard JS -->
    <script src="~/js/setup-wizard.js" asp-append-version="true"></script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
