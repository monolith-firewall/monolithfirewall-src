@page "/groups"
@{
    Layout = null;
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>User Groups</h2>
        <button class="btn btn-primary" id="btn-add-group">Add Group</button>
    </div>
    <div id="groups-table-container"></div>
    <div id="group-modal-container"></div>
</div>

@section Scripts {
    <script src="/js/pages/groups.js" data-module-js="groups"></script>
}
